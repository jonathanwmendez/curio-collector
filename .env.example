# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# eBay developer app (developer.ebay.com > Application Keys > Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Shared secret for the nightly eBay asking-price cron (also stored hashed in the database)
CRON_SECRET=
